# Create the "main" window and run an editor in it to edit the project files
new_tab complex tab
layout splits
launch --title "Workspace" --var window=first  bash -c 'docker start -i CONTAINER_ID'

launch --title "Terminal_1" --location=hsplit bash -c 'sleep 0.5s && docker exec -it CONTAINER_ID /bin/bash'
resize_window shorter 15
launch --title "Terminal_2" --location=vsplit bash -c 'sleep 0.5s && docker exec -it CONTAINER_ID /bin/bash'

focus_matching_window var:window=first
launch --location=vsplit --env OPENCODE_CONFIG_DIR=/home/christian/Dev/dev-env/opencode --dont-take-focus opencode 
resize_window narrower 45


